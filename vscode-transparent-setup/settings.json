  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["comment"],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#8ea0b5"
        }
      },
      {
        "scope": ["string", "constant.other.symbol"],
        "settings": {
          "foreground": "#aad94c"
        }
      },
      {
        "scope": ["string.regexp", "constant.character", "constant.other"],
        "settings": {
          "foreground": "#95e6cb"
        }
      },
      {
        "scope": ["constant.numeric", "constant.language"],
        "settings": {
          "foreground": "#d2a6ff"
        }
      },
      {
        "scope": ["variable", "variable.parameter.function-call"],
        "settings": {
          "foreground": "#e2e6eb"
        }
      },
      {
        "scope": ["variable.member"],
        "settings": {
          "foreground": "#f07178"
        }
      },
      {
        "scope": ["variable.language"],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#39bae6"
        }
      },
      {
        "scope": ["storage", "keyword", "storage.type.function"],
        "settings": {
          "foreground": "#ff8f40"
        }
      },
      {
        "scope": ["keyword.operator", "punctuation.accessor"],
        "settings": {
          "foreground": "#f29668"
        }
      },
      {
        "scope": ["punctuation.separator", "punctuation.terminator"],
        "settings": {
          "foreground": "#bfbdb6b3"
        }
      },
      {
        "scope": ["punctuation.section", "meta.embedded"],
        "settings": {
          "foreground": "#bfbdb6"
        }
      },
      {
        "scope": ["entity.name.function", "support.function"],
        "settings": {
          "foreground": "#ffb454"
        }
      },
      {
        "scope": ["entity.name.type", "entity.other.inherited-class", "support.class", "support.type"],
        "settings": {
          "foreground": "#59c2ff"
        }
      }
    ]
  }
}
