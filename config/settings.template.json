  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "class": {
        "foreground": "#59c2ff",
        "italic": true
      },
      "class.defaultLibrary": {
        "foreground": "#39bae6",
        "italic": true
      },
      "enum": {
        "foreground": "#59c2ff",
        "italic": true
      },
      "enum.defaultLibrary": {
        "foreground": "#39bae6",
        "italic": true
      },
      "interface": {
        "foreground": "#39bae6",
        "italic": true
      },
      "interface.defaultLibrary": {
        "foreground": "#39bae6",
        "italic": true
      },
      "struct": {
        "foreground": "#59c2ff",
        "italic": true
      },
      "struct.defaultLibrary": {
        "foreground": "#39bae6",
        "italic": true
      },
      "type": {
        "foreground": "#59c2ff",
        "italic": true
      },
      "type.defaultLibrary": {
        "foreground": "#39bae6",
        "italic": true
      },
      "parameter": {
        "italic": true
      },
      "keyword": {
        "foreground": "#ff8f40",
        "italic": true
      },
      "enumMember": "#95e6cb",
      "event": "#f29668",
      "function": "#ffb454",
      "method": "#ffb454",
      "macro": "#e6c08a",
      "comment": "#5a6673",
      "string": "#aad94c",
      "number": "#d2a6ff",
      "regexp": "#95e6cb",
      "operator": "#f29668"
    }
  },
  "terminal.integrated.fontWeight": "600",
  "terminal.integrated.fontFamily": "JetBrains Mono, 'MesloLGS NF', monospace",
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.fontWeightBold": "700",
  "terminal.integrated.fontSize": 15,
  "git.autofetch": true,
  "explorer.confirmDelete": false,
  "python.analysis.typeCheckingMode": "basic",
  "diffEditor.maxComputationTime": 0,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.minimap.enabled": false,
  "makefile.configureOnOpen": true,
  "code-runner.runInTerminal": true,
  "code-runner.executorMap": {
    "cpp": "{{HOME}}/.vscode/leetcode_build.sh \"$fullFileName\" \"/tmp/leetcode_build/$fileNameWithoutExt\" && \"/tmp/leetcode_build/$fileNameWithoutExt\""
  },
  "window.titleBarStyle": "custom",
  "vscode_vibrancy.enableAutoTheme": false,
  "workbench.activityBar.location": "top",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "chat.agent.maxRequests": 50,
  "githubPullRequests.pullBranch": "never",
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-pdf",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "editor.stickyScroll.enabled": false,
  "terminal.external.osxExec": "Warp.app",
  "vscode_vibrancy.opacity": 0.6,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "python": false
