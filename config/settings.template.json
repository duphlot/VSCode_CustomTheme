  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug LeetCode",
        "type": "lldb",
        "request": "launch",
        "program": "/tmp/leetcode_build/${fileBasenameNoExtension}",
        "args": [],
        "cwd": "${fileDirname}",
        "preLaunchTask": "build-leetcode",
        "terminal": "integrated"
      }
    ],
    "compounds": []
  },
