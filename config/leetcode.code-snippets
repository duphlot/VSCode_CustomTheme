    "DSU / Union-Find": {
        "scope": "cpp",
        "prefix": [
            "dsu",
            "unionfind"
        ],
        "body": [
            "struct DSU {",
            "    vector<int> parent, rank;",
            "    DSU(int n) : parent(n), rank(n, 0) {",
            "        iota(parent.begin(), parent.end(), 0);",
            "    }",
            "    int find(int x) {",
            "        if (parent[x] != x) parent[x] = find(parent[x]);",
            "        return parent[x];",
            "    }",
            "    bool unite(int x, int y) {",
            "        int rx = find(x), ry = find(y);",
            "        if (rx == ry) return false;",
            "        if (rank[rx] < rank[ry]) swap(rx, ry);",
            "        parent[ry] = rx;",
            "        if (rank[rx] == rank[ry]) rank[rx]++;",
            "        return true;",
            "    }",
            "    bool connected(int x, int y) {",
            "        return find(x) == find(y);",
            "    }",
            "};"
        ],
        "description": "Disjoint Set Union (DSU) / Union-Find with rank & path compression"
    },
    "Binary Exponentiation (Pow Mod)": {
        "scope": "cpp",
        "prefix": [
            "powmod",
            "binpow"
        ],
        "body": [
            "long long power(long long base, long long exp, long long mod = 1e9 + 7) {",
            "    long long res = 1;",
            "    base %= mod;",
            "    while (exp > 0) {",
            "        if (exp & 1) res = (res * base) % mod;",
            "        base = (base * base) % mod;",
            "        exp >>= 1;",
            "    }",
            "    return res;",
            "}"
        ],
        "description": "Fast power modulo (base^exp % mod)"
    },
